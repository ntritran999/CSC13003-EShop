{
  "consumer": {
    "name": "MyConsumer"
  },
  "interactions": [
    {
      "description": "a request to create a coupon with a duplicate code",
      "providerStates": [
        {
          "name": "a coupon with code DUPLICATE10 already exists"
        }
      ],
      "request": {
        "body": {
          "code": "DUPLICATE10",
          "discount_value": 10,
          "expired_at": "2027-12-31",
          "max_uses_per_user": 1,
          "min_order_amount": 0,
          "type": "percent"
        },
        "headers": {
          "Authorization": "Bearer abc123token",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/admin/coupons"
      },
      "response": {
        "body": {
          "error": "Internal server error"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      }
    },
    {
      "description": "a request to create a new coupon",
      "providerStates": [
        {
          "name": "I am logged in as admin"
        }
      ],
      "request": {
        "body": {
          "code": "TET2025",
          "discount_value": 15,
          "expired_at": "2027-12-31",
          "max_uses_per_user": 1,
          "min_order_amount": 200000,
          "type": "percent"
        },
        "headers": {
          "Authorization": "Bearer abc123token",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/admin/coupons"
      },
      "response": {
        "body": {
          "id": 1,
          "message": "Coupon created successfully"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to create coupon without admin token",
      "providerStates": [
        {
          "name": "I am not authenticated as admin"
        }
      ],
      "request": {
        "body": {
          "code": "NOAUTH01",
          "discount_value": 10,
          "expired_at": "2027-12-31",
          "max_uses_per_user": 1,
          "min_order_amount": 0,
          "type": "percent"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/admin/coupons"
      },
      "response": {
        "body": {
          "error": "Unauthorized"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "MyProvider"
  }
}