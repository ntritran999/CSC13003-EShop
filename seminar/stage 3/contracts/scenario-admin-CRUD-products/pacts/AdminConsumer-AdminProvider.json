{
  "consumer": {
    "name": "AdminConsumer"
  },
  "interactions": [
    {
      "description": "a request to create a new product",
      "request": {
        "body": {
          "category_id": 2,
          "description": "Mô tả sản phẩm mới",
          "imageUrl": "http://example.com/image.png",
          "name": "New Admin Product",
          "price": 15000000
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/products"
      },
      "response": {
        "status": 200
      }
    },
    {
      "description": "a request to update a product by id",
      "request": {
        "body": {
          "name": "Updated Product Name",
          "price": 20000000
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "PUT",
        "path": "/api/products/1"
      },
      "response": {
        "status": 200
      }
    },
    {
      "description": "a request to delete a product by id",
      "request": {
        "method": "DELETE",
        "path": "/api/products/1"
      },
      "response": {
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "AdminProvider"
  }
}