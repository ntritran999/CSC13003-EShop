{
  "info": {
    "_postman_id": "6fc09515-3105-4a74-9f51-c38e28d56c1a",
    "name": "E2E - Coupon Flow Manage",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "45118778"
  },
  "item": [
    {
      "name": "Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token is saved to collection variables\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.collectionVariables.set(\"adminToken\", jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@eshop.com\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin Create Coupon",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Sinh mã ngẫu nhiên để tránh lỗi trùng lặp khi chạy nhiều iteration",
              "var randomCode = \"MANUAL\" + pm.variables.replaceIn(\"{{$randomInt}}\");",
              "pm.collectionVariables.set(\"couponCode\", randomCode);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Save coupon ID to collection variables\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"couponId\", jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{couponCode}}\",\n  \"type\": \"percent\",\n  \"discount_value\": 10,\n  \"min_order_amount\": 0,\n  \"expired_at\": \"2027-12-31\",\n  \"max_uses_per_user\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "coupons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin View Coupon List",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Save user details to collection variables\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set(\"userToken\", jsonData.token);",
              "    if(jsonData.user && jsonData.user.id) {",
              "        pm.collectionVariables.set(\"userId\", jsonData.user.id);",
              "    } else {",
              "        pm.collectionVariables.set(\"userId\", 1);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@eshop.com\",\n  \"password\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "User Apply Coupon",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Coupon applied and returns amounts\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.discount_amount).to.exist;",
              "    pm.expect(jsonData.final_amount).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{couponCode}}\",\n  \"total_amount\": 500000,\n  \"user_id\": {{userId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/apply-coupon",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "apply-coupon"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin Create Another Coupon",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Save second coupon ID for deletion\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"couponToDeleteId\", jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"MANUAL-DEL-{{$randomInt}}\",\n  \"type\": \"percent\",\n  \"discount_value\": 20,\n  \"min_order_amount\": 0,\n  \"expired_at\": \"2027-12-31\",\n  \"max_uses_per_user\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "coupons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin Delete Coupon",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/coupons/{{couponToDeleteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "coupons",
            "{{couponToDeleteId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin Verify Deleted Coupon",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons"
          ]
        }
      },
      "response": []
    }
  ],
