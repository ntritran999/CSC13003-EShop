    {
      "name": "Verify Product Created",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const product = pm.response.json();\r",
              "\r",
              "pm.test(\"Correct product name\", function () {\r",
              "    pm.expect(product.name)\r",
              "      .to.eql(\"Tên sản phẩm\");\r",
              "});\r",
              "\r",
              "pm.test(\"Correct category\", function () {\r",
              "    pm.expect(product.category_id)\r",
              "      .to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Correct price\", function () {\r",
              "    pm.expect(Number(product.price))\r",
              "      .to.deep.eql(100000);\r",
              "});\r",
              "\r",
              "pm.test(\"Correct desciption\", function () {\r",
              "    pm.expect(product.description)\r",
              "      .to.eql(\"Mô tả\");\r",
              "});\r",
              "\r",
              "pm.test(\"Correct imageUrl\", function () {\r",
              "    pm.expect(product.imageUrl)\r",
              "      .to.eql(\"http://...\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
