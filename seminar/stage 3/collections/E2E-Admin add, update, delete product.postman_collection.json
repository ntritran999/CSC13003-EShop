        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Tên sản phẩm\",\r\n  \"price\": 100000,\r\n  \"description\": \"Mô tả\",\r\n  \"imageUrl\": \"http://...\",\r\n  \"category_id\": 1\r\n}",
