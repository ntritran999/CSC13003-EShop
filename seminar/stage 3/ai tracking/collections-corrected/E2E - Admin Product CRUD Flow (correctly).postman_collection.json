    {
      "name": "Verify Newly Created Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Product name matches created product\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql(\"E2E Test Product\");",
              "    pm.expect(Number(jsonData.price)).to.deep.eql(99.99);",
              "    pm.expect(jsonData.description).to.eql(\"A product created during E2E testing\")",
              "    pm.expect(jsonData.category_id).to.eql(1)",
              "    pm.expect(jsonData.imageUrl).to.eql(\"http://...\")",
              "});"
