        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"E2E Test Product\",\n  \"price\": 99.99,\n  \"description\": \"A product created during E2E testing\",\n  \"category_id\": 1,\n  \"imageUrl\": \"http://...\"\n}",
