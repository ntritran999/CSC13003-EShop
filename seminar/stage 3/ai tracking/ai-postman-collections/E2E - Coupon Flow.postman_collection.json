{
  "info": {
    "_postman_id": "cb8572a6-32fb-4802-9a25-8951a3f6de8a",
    "name": "EShop - Coupon E2E Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "45118778"
  },
  "item": [
    {
      "name": "Coupon E2E Flow",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has token\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.collectionVariables.set(\"adminToken\", json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eshop.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Create Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Coupon created with correct code\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"code\");",
                  "    pm.expect(json.code).to.eql(\"SAVE10\");",
                  "    pm.collectionVariables.set(\"couponId\", json.id);",
                  "    pm.collectionVariables.set(\"couponCode\", json.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE10\",\n  \"discount\": 10,\n  \"expiryDate\": \"2027-12-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin View Coupon List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Created coupon SAVE10 exists in list\", function () {",
                  "    var coupons = pm.response.json();",
                  "    var found = coupons.some(function(c) { return c.code === \"SAVE10\"; });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons"
              ]
            }
          },
          "response": []
        },
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has userToken and user ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    // Kiểm tra và lưu userToken",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.token);",
                  "    ",
                  "    // Lưu ý: Lấy user_id để dùng cho bước Apply Coupon tiếp theo",
                  "    if(jsonData.user && jsonData.user.id) {",
                  "        pm.collectionVariables.set(\"userId\", jsonData.user.id);",
                  "    } else {",
                  "        // Fallback mặc định theo API spec nếu không có sẵn",
                  "        pm.collectionVariables.set(\"userId\", 1);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@domain.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "User Apply Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Coupon applied successfully - validates response structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"discount_amount\");",
                  "    pm.expect(jsonData).to.have.property(\"final_amount\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponCode}}\",\n  \"total_amount\": 500000,\n  \"user_id\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/apply-coupon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "apply-coupon"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Verify Used Coupon Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Verify used coupon SAVE10 status\", function () {",
                  "    var coupons = pm.response.json();",
                  "    var coupon = coupons.find(function(c) { return c.code === \"SAVE10\"; });",
                  "    if (!coupon) {",
                  "        // Coupon was removed after use",
                  "        pm.expect(true).to.be.true;",
                  "        console.log(\"SAVE10 coupon was removed from the list after use.\");",
                  "    } else {",
                  "        // Coupon still exists but should be marked used/inactive",
                  "        var isUsed = coupon.isUsed === true || coupon.status === \"used\" || coupon.active === false || coupon.used === true;",
                  "        pm.expect(isUsed).to.be.true;",
                  "        console.log(\"SAVE10 coupon is still in list but marked as used/inactive.\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Create Another Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Second coupon created with correct code\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"code\");",
                  "    pm.expect(json.code).to.eql(\"DELETE20\");",
                  "    pm.collectionVariables.set(\"couponToDeleteId\", json.id);",
                  "    pm.collectionVariables.set(\"couponToDeleteCode\", json.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"DELETE20\",\n  \"discount\": 20,\n  \"expiryDate\": \"2027-12-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Delete That Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "pm.test(\"Coupon DELETE20 deleted successfully\", function () {",
                  "    if (pm.response.code === 200) {",
                  "        var json = pm.response.json();",
                  "        // Accept any success message or empty body",
                  "        pm.expect(json).to.exist;",
                  "    } else {",
                  "        // 204 No Content is a valid success response",
                  "        pm.expect(pm.response.code).to.eql(204);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons/{{couponToDeleteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons",
                "{{couponToDeleteId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Verify Deleted Coupon Disappears",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Deleted coupon DELETE20 no longer exists in list\", function () {",
                  "    var coupons = pm.response.json();",
                  "    var found = coupons.some(function(c) { return c.code === \"DELETE20\"; });",
                  "    pm.expect(found).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coupons"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
